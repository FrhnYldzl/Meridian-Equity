# ═══════════════════════════════════════════════════════════════════
# Dockerfile.equity — Meridian Capital · Equity V6.0 Module
# ═══════════════════════════════════════════════════════════════════
# Kullanım: SADECE Railway'in YENİ "meridian-equity-v6" project'inde
# build edilir. Mevcut equity project ('devine-laughter') V5.7 main:app
# ile çalışmaya devam eder, etkilenmez.
#
# Strangler fig stratejisi: V6.0 yan yana, V5.7 dokunulmaz.
#
# Mevcut Dockerfile (V5.7 equity) ile fark: SADECE CMD farklı.
# equity_preview_app:app entrypoint'i kullanır → /api/equity/* endpoints
# + /static/equity/index.html dashboard (green theme).
# ═══════════════════════════════════════════════════════════════════

FROM python:3.12-slim

WORKDIR /app

# Sistem bagimliliklari
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Python bagimliliklari
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Tum proje kodu (V5.7 equity dosyalari da dahil — calistirilmazlar
# ama equity_preview_app onlari import ederek kullanir, ornegin
# equity/audit_impl.py mevcut gemini_auditor pattern'inden cagri yapar)
COPY server/ ./server/

# Python module path
ENV PYTHONPATH=/app/server

# Railway PORT env var inject eder; varsayilan 8000
ENV PORT=8000
EXPOSE 8000

WORKDIR /app/server

# EQUITY V6.0 ENTRYPOINT — V5.7 main:app'inden farkli
# JSON array form (Docker linter warning-free, signal handling temiz)
CMD ["sh", "-c", "exec uvicorn equity_preview_app:app --host 0.0.0.0 --port ${PORT:-8000}"]
